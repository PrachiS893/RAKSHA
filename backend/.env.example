# Database connection string
DATABASE_URL=sqlite:///./raksha.db

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Application environment (e.g. dev, staging, prod)
APP_ENV=dev
AUTO_SEED=true

# External API Keys & Models (leave empty if not configured; Groq API key from console.groq.com/keys)
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=10
TRIAGE_ON_SUBMIT=true
TELEGRAM_BOT_TOKEN=
DEMO_TELEGRAM_CHAT_ID=
ORS_API_KEY=

# Weather Service Configuration
WEATHER_CACHE_DIR=data/weather_cache
WEATHER_TIMEOUT_SECONDS=8

# Routing Service Configuration
ROUTING_ENABLED=true
ROUTING_PROFILE=driving-car
ROUTING_TIMEOUT_SECONDS=6
ROUTE_CACHE_DIR=data/route_cache
OSRM_BASE_URL=https://router.project-osrm.org
